<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient 7.1.1 pulls in System.Security.Cryptography.Pkcs 9.0.18, which has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedflyCoreFramework\redflyCoreFramework.csproj" />
    <ProjectReference Include="..\RedflyLocalStorage\redflyLocalStorage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="protos\sync-api-service.proto" GrpcServices="Client" />
    <Protobuf Include="protos\user-setup.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
