<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient 7.1.1 pulls in System.Security.Cryptography.Pkcs 9.0.18, which has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
  </ItemGroup>

</Project>
